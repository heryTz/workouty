POSTGRES_USER=workouty
POSTGRES_PASSWORD=workouty_dev_password
POSTGRES_DB=workouty

# PowerSync replicates as its own role — REPLICATION plus read-only SELECT — rather than as
# the app owner. Created by infra/postgres/powersync-role.sql; see docs/development.md.
PS_REPLICATION_USER=powersync_role
PS_REPLICATION_PASSWORD=powersync_replication_dev_password

PS_STORAGE_USER=powersync_storage
PS_STORAGE_PASSWORD=powersync_dev_password
PS_STORAGE_DB=powersync_storage

# Used by drizzle-kit and the API's tests from the host, so it targets the published port.
DATABASE_URL=postgresql://workouty:workouty_dev_password@localhost:6103/workouty

# RS256 private key for signing access tokens, as base64-encoded PKCS8 PEM.
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform PEM | openssl pkcs8 -topk8 -nocrypt | base64 -w0
# (a dev key is fine locally; production supplies its own and never commits it)
JWT_PRIVATE_KEY=

# SMTP endpoint used to send mail. The api container gets its own value
# (smtp://mailpit:1025, over the Compose network) hardcoded in compose.yml; this one
# is for the API's tests run from the host (e.g. reset.e2e.test.ts), which reach Mailpit via
# its published port instead.
SMTP_URL=smtp://localhost:6105

# Base URL of the (not-yet-built) web app's password-reset page. The reset email links to
# `${APP_RESET_URL_BASE}?token=...`. A placeholder is fine until that page exists.
APP_RESET_URL_BASE=https://app.workouty.local/reset

# Comma-separated allowed web origins for CORS (e.g. https://app.workouty.com). Unset = allow
# all origins (dev only, safe here since the API uses Bearer tokens, not cookies). Production
# should set this to the real web origin(s).
CORS_ORIGINS=

# Bearer token for PowerSync's admin API (/api/admin/v1/diagnostics), which is how you see
# replication errors — the health probes stay green while replication is broken. Generate with:
#   openssl rand -hex 32
PS_ADMIN_TOKEN=5958c6af6b42561d951288198164fa0b7fcc1cc41b45f3dec4b9bdd2aac25f6b
