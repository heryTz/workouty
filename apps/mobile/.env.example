# Read by apps/mobile/src/powersync/PowerSyncProvider.tsx. EXPO_PUBLIC_* vars are inlined
# into the JS bundle at build time by Expo (https://docs.expo.dev/versions/v57.0.0/guides/environment-variables/) —
# there is no runtime override once bundled. Copy this file to apps/mobile/.env (gitignored)
# and adjust as needed; unset vars fall back to the same localhost defaults baked into
# PowerSyncProvider.tsx.
#
# The values below match compose.yml's published ports (api :6100, powersync :6101)
# and work for the iOS simulator / Android emulator, which can reach the host machine via
# localhost. A PHYSICAL DEVICE on the same LAN cannot resolve `localhost` to your dev
# machine — point these at your machine's LAN IP instead, e.g. http://192.168.1.23:6100 and
# http://192.168.1.23:6101.
EXPO_PUBLIC_API_URL=http://localhost:6100
EXPO_PUBLIC_POWERSYNC_URL=http://localhost:6101
