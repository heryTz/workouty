# Plain HTTP: the container sits behind whatever terminates TLS, and Caddy's automatic HTTPS
# would try to provision a certificate for a hostname it can't validate. Drop this to
# `example.com { ... }` if you want Caddy doing ACME itself.
:80 {
	root * /srv
	encode zstd gzip

	@immutable path /_expo/static/* /assets/* /@powersync/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Inverse of @immutable on purpose: matchers see the ORIGINAL request path, and routes are
	# requested extensionless (the .html only appears after try_files rewrites internally), so
	# `path *.html` would silently miss every one of them.
	@revalidate not path /_expo/static/* /assets/* /@powersync/*
	header @revalidate Cache-Control "no-cache"

	# WebAssembly.instantiateStreaming rejects any response whose Content-Type isn't exactly this.
	@wasm path *.wasm
	header @wasm Content-Type "application/wasm"

	# Directives inside `route` run in written order: the /session/ rewrite has to be reached
	# before the catch-all try_files.
	route {
		handle /healthz {
			respond "ok" 200
		}

		# Expo names the dynamic route's export literally `session/[id].html`. In-app navigation
		# never requests it, but a hard load or refresh of /session/<uuid> does.
		handle /session/* {
			rewrite * "/session/[id].html"
			file_server
		}

		handle {
			try_files {path} {path}.html {path}/index.html /+not-found.html

			# try_files can't set a status, and a 200 on the not-found page tells crawlers and
			# uptime checks that every typo'd URL is a real page.
			@notfound path /+not-found.html
			file_server @notfound {
				status 404
			}
			file_server
		}
	}
}
