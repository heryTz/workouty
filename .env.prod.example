# Copy to `.env.prod` and fill in. See the README for how it is used.

WEB_PORT=6102
API_PORT=6100
POWERSYNC_PORT=6101

# Must be reachable FROM THE USER'S BROWSER, not merely from inside the Compose network — the
# web app is static JS that calls the API and opens the PowerSync stream directly, so a
# Compose hostname like `http://api:3000` would never resolve. PUBLIC_API_URL and
# PUBLIC_POWERSYNC_URL are build args baked into the bundle: changing them needs `up --build`.
PUBLIC_WEB_URL=http://localhost:6102
PUBLIC_API_URL=http://localhost:6100
PUBLIC_POWERSYNC_URL=http://localhost:6101

POSTGRES_USER=workouty
POSTGRES_PASSWORD=CHANGE_ME_app_db_password
POSTGRES_DB=workouty

# PowerSync replicates as its own role — REPLICATION plus read-only SELECT on the app schema —
# rather than as the app owner. `db-bootstrap` creates it from infra/postgres/powersync-role.sql
# on every `up`, so changing the password here and redeploying rotates it.
PS_REPLICATION_USER=powersync_role
PS_REPLICATION_PASSWORD=CHANGE_ME_replication_password

# PowerSync's own bucket storage, unrelated to the app schema. Give it a different password.
PS_STORAGE_USER=powersync_storage
PS_STORAGE_PASSWORD=CHANGE_ME_storage_db_password
PS_STORAGE_DB=powersync_storage

# Base64-encoded PKCS8 PEM. The API serves the matching public key at /.well-known/jwks.json,
# which PowerSync validates client tokens against, so rotating this invalidates every issued
# token. One per environment:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform PEM \
#     | openssl pkcs8 -topk8 -nocrypt | base64 -w0
JWT_PRIVATE_KEY=

# An external relay — this stack ships no mail service. Nodemailer builds the transport
# lazily, so a wrong value still starts and still reports healthy; it surfaces only when a
# reset mail is actually sent. Send yourself one after deploying.
SMTP_URL=

# Bearer token for PowerSync's admin API (/api/admin/v1/diagnostics), which is how you see
# replication errors — the health probes stay green while replication is broken. Served on the
# same port as the sync API, so keep /api/admin/ off the public internet at your proxy.
# Generate one per environment:
#   openssl rand -hex 32
PS_ADMIN_TOKEN=
